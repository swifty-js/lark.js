{
  "name": "@lark.js/docs",
  "version": "0.0.13",
  "description": "Documentation site generator for @lark.js/mvc",
  "keywords": [
    "@lark.js",
    "markdown",
    "documentation",
    "docs"
  ],
  "repository": {
    "url": "https://github.com/tianchenghang/lark.js",
    "directory": "packages/lark-docs"
  },
  "license": "MIT",
  "author": "https://github.com/hangtiancheng",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./compiler": {
      "import": {
        "types": "./dist/compiler.d.ts",
        "default": "./dist/compiler.js"
      },
      "require": {
        "types": "./dist/compiler.d.ts",
        "default": "./dist/compiler.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "require": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.cjs"
      }
    },
    "./webpack": {
      "import": {
        "types": "./dist/webpack.d.ts",
        "default": "./dist/webpack.js"
      },
      "require": {
        "types": "./dist/webpack.d.ts",
        "default": "./dist/webpack.cjs"
      }
    },
    "./rspack": {
      "import": {
        "types": "./dist/rspack.d.ts",
        "default": "./dist/rspack.js"
      },
      "require": {
        "types": "./dist/rspack.d.ts",
        "default": "./dist/rspack.cjs"
      }
    },
    "./runtime": {
      "import": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      },
      "require": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.cjs"
      }
    },
    "./theme": {
      "import": {
        "types": "./dist/theme/index.d.ts",
        "default": "./dist/theme.js"
      },
      "require": {
        "types": "./dist/theme/index.d.ts",
        "default": "./dist/theme.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts"
      },
      "require": {
        "types": "./dist/client.d.ts"
      }
    },
    "./client.css": "./dist/client.css"
  },
  "scripts": {
    "prepublishOnly": "pnpm build",
    "git:pull": "node ./pull.js",
    "build": "vite build --mode lib",
    "build:docs": "vite build --mode docs",
    "build:watch": "vite build --mode lib --watch",
    "dev": "DOCS_PASSWORD=pass vite --mode docs",
    "preview": "vite preview --mode docs",
    "format": "prettier -w ./ --experimental-cli",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pwa": "pnpm dlx @vite-pwa/assets-generator --preset minimal public/favicon.svg",
    "add:user": "npm adduser --registry=https://registry.npmjs.org/",
    "publish:latest": "npm publish --access public --registry=https://registry.npmjs.org/",
    "publish:alpha": "npm publish --access public --registry=https://registry.npmjs.org/ --tag alpha",
    "publish:beta": "npm publish --access public --registry=https://registry.npmjs.org/ --tag beta",
    "publish:rc": "npm publish --access public --registry=https://registry.npmjs.org/ --tag rc",
    "publish:canary": "npm publish --access public --registry=https://registry.npmjs.org/ --tag canary",
    "publish:nightly": "npm publish --access public --registry=https://registry.npmjs.org/ --tag nightly",
    "publish:dev": "npm publish --access public --registry=https://registry.npmjs.org/ --tag dev"
  },
  "dependencies": {
    "@lark.js/mvc": "^0.0.23",
    "ejs": "^3.1.10",
    "js-yaml": "^5.2.2",
    "lucide-static": "^1.27.0",
    "markdown-it": "^14.3.0",
    "markdown-it-container": "^4.0.0",
    "minisearch": "^7.2.0",
    "shiki": "^4.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/ejs": "^3.1.5",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-container": "^4.0.0",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "4.1.9",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@tailwindcss/typography": "^0.5.0",
    "tailwindcss": "^4.0.0"
  },
  "packageManager": "pnpm@10.33.1"
}
