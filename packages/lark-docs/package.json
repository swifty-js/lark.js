{
  "name": "@lark.js/docs",
  "version": "0.0.23",
  "description": "All-in-one documentation site generator (@swifty.js/docs + @swifty.js/sentry + @swifty.js/anti-copy)",
  "keywords": [
    "anti-copy",
    "docs",
    "documentation",
    "lark.js",
    "sentry",
    "swifty.js"
  ],
  "license": "MIT",
  "author": "https://github.com/hangtiancheng",
  "repository": {
    "url": "https://github.com/tianchenghang/lark.js",
    "directory": "packages/lark-docs"
  },
  "files": [
    "dist",
    "src/client.d.ts",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "require": {
        "types": "./dist/vite.d.cts",
        "default": "./dist/vite.cjs"
      }
    },
    "./compiler": {
      "import": {
        "types": "./dist/compiler.d.ts",
        "default": "./dist/compiler.js"
      },
      "require": {
        "types": "./dist/compiler.d.cts",
        "default": "./dist/compiler.cjs"
      }
    },
    "./runtime": {
      "import": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      },
      "require": {
        "types": "./dist/runtime.d.cts",
        "default": "./dist/runtime.cjs"
      }
    },
    "./theme": {
      "import": {
        "types": "./dist/theme.d.ts",
        "default": "./dist/theme.js"
      },
      "require": {
        "types": "./dist/theme.d.cts",
        "default": "./dist/theme.cjs"
      }
    },
    "./plugins": {
      "import": {
        "types": "./dist/plugins.d.ts",
        "default": "./dist/plugins.js"
      },
      "require": {
        "types": "./dist/plugins.d.cts",
        "default": "./dist/plugins.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./src/client.d.ts"
      },
      "require": {
        "types": "./src/client.d.ts"
      }
    },
    "./client.css": "./dist/client.css"
  },
  "scripts": {
    "build": "tsup",
    "format": "oxfmt --write ./",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@swifty.js/anti-copy": "latest",
    "@swifty.js/docs": "latest",
    "@swifty.js/sentry": "latest"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "oxfmt": "^0.61.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
