{
  "name": "@lark.js/docs",
  "version": "0.0.26",
  "description": "Composable VitePress helpers: auto-generated nav/sidebar and Lit-rendered Mermaid diagrams.",
  "keywords": [
    "docs",
    "documentation",
    "lark.js",
    "lit",
    "mermaid",
    "vitepress"
  ],
  "license": "MIT",
  "author": "https://github.com/hangtiancheng",
  "repository": {
    "url": "https://github.com/swifty-js/lark.js",
    "directory": "packages/lark-docs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/element.js",
    "./dist/chunk-*"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "format": "oxfmt --write ./",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "lit": "^3.3.3",
    "mermaid": "^11.17.2"
  },
  "devDependencies": {
    "oxfmt": "^0.61.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitepress": "^1.6.0 || ^2.0.0"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0",
    "vitepress": "^1.0.0 || ^2.0.0-0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}
