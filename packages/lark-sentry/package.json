{
  "name": "@lark.js/sentry",
  "version": "0.0.13",
  "description": "@swifty.js/sentry framework-level integration for lark framework (@lark.js/mvc)",
  "keywords": [
    "error-tracking",
    "lark.js",
    "monitoring",
    "mvc",
    "sentry",
    "swifty.js"
  ],
  "license": "MIT",
  "author": "https://github.com/hangtiancheng",
  "repository": {
    "url": "https://github.com/tianchenghang/lark.js",
    "directory": "packages/lark-sentry"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "prepublish": "pnpm build",
    "build": "tsup",
    "format": "oxfmt --write ./",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@lark.js/mvc": "workspace:^",
    "@swifty.js/sentry": "^0.0.4",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.61.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@lark.js/mvc": ">=0.0.24",
    "@swifty.js/sentry": ">=0.0.4"
  },
  "packageManager": "pnpm@10.33.1"
}
