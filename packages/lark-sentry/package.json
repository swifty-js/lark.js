{
  "name": "@lark.js/sentry",
  "version": "0.0.19",
  "description": "Framework-level @swifty.js/sentry integration for lark-mvc (@lark.js/mvc): route-pattern tracking, lazy-route instrumentation, component profiler, exposure hook, store state on error reports",
  "keywords": [
    "lark.js",
    "mvc",
    "sentry",
    "swifty.js"
  ],
  "license": "MIT",
  "author": "https://github.com/hangtiancheng",
  "repository": {
    "url": "https://github.com/swifty-js/lark.js",
    "directory": "packages/lark-sentry"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./plugins": {
      "import": {
        "types": "./dist/plugins.d.ts",
        "default": "./dist/plugins.js"
      },
      "require": {
        "types": "./dist/plugins.d.cts",
        "default": "./dist/plugins.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "require": {
        "types": "./dist/vite.d.cts",
        "default": "./dist/vite.cjs"
      }
    },
    "./webpack": {
      "import": {
        "types": "./dist/webpack.d.ts",
        "default": "./dist/webpack.js"
      },
      "require": {
        "types": "./dist/webpack.d.cts",
        "default": "./dist/webpack.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "format": "oxfmt --write ./",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@lark.js/mvc": "workspace:*",
    "@swifty.js/sentry": "^0.0.5",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.61.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@lark.js/mvc": ">=0.0.34",
    "@swifty.js/sentry": ">=0.0.5",
    "vite": "^7.0.0 || ^8.0.0",
    "webpack": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  }
}
