{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@lark.js/react",
    "types": [],
    "paths": {
      "@lark.js/react/jsx-dev-runtime": ["./lib/jsx-dev-runtime.ts"],
      "@lark.js/react/jsx-runtime": ["./lib/jsx-runtime.ts"],
      "@lark.js/react/vite": ["./lib/vite.ts"],
      "@lark.js/react/webpack": ["./lib/webpack.ts"],
      "@lark.js/react": ["./lib/index.ts"]
    }
  },
  "include": ["lib", "tests", "tsup.config.ts", "vitest.config.ts"]
}
